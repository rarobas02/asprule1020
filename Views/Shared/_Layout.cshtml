                            <div class="container">
                                <div class="row justify-content-center">

                                    <div class="col-xl-5 col-md-8">
                                        <div class="card-group d-block d-md-flex row">
                                            <div class="card col-md-7 p-2 mb-2">
                                                <div class="modal-content">

                                                    <!--Header-->
                                                    <div class="text-center mb-8 bg-primary text-light">
                                                        <br>
                                                        <div style="font-size: 2.5rem;" class="mt-1">
                                                            <strong>
                                                                <h3>Rule 1020 Online Application</h3>
                                                            </strong>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                            <!--/.Content-->
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <!-- <a href="#" class="nav-item nav-link" style="color:white">Register</a> -->
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </nav>

    @*<div class="container">*@
