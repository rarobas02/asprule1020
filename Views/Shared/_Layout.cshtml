<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary">
        <div class="container-fluid">

            <a href="https://calabarzon.dole.gov.ph" target="_blank" class="navbar-brand">
                <img class="h-50" src="~/img/Client/dole-system-logo-triangle.png" alt="DOLE LOGO">
            </a>
            <div class="col text-light">
                <h1 class="d-flex"><strong>RULE 1020 ONLINE</strong></h1>
                <h6>&nbsp;DEPARTMENT OF LABOR AND EMPLOYMENT REGIONAL OFFICE IV-A</h6>
            </div>
            <div class="collapse navbar-collapse" id="navbarCollapse">
