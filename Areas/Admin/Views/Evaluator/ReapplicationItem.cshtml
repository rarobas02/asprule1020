                type="button"
                role="tab"
                aria-controls="registration_details"
                aria-selected="true">
            <i class="fa-solid fa-arrow-trend-up fa-xs me-1"></i>
            Registration Details
            <span class="badge badge-pill badge-danger ms-2 registration_details-badge"></span>
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link d-flex align-self-start align-items-center"
                id="branch-units-ap-tab"
                data-bs-toggle="tab"
                data-bs-target="#branch-units"
                type="button"
                role="tab"
                aria-controls="branch-units"
                aria-selected="true">
            <i class="fa-solid fa-arrow-trend-up fa-xs me-1"></i>
            Branch Units
            <span class="badge badge-pill badge-danger ms-2 branch-units-badge"></span>
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link d-flex align-self-start align-items-center"
                id="labor-unions-ap-tab"
                data-bs-toggle="tab"
                data-bs-target="#labor-unions"
                type="button"
                role="tab"
                aria-controls="labor-unions"
                aria-selected="true">
            <i class="fa-solid fa-arrow-trend-up fa-xs me-1"></i>
            Labor Unions
            <span class="badge badge-pill badge-danger ms-2 labor-unions-badge"></span>
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link d-flex align-self-start align-items-center"
                id="approved_action-ap-tab"
                data-bs-toggle="tab"
                data-bs-target="#approved_action"
