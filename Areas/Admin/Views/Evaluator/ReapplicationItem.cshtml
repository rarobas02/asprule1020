                        <input asp-for="Remarks.est_bperm_validity_input" type="text" class="form-control mb-3 input-remarks" readonly />
                    </dd>
                </div>
                <hr class="row mb-3" />
                <div class="row gap-3">
                    <dt class="col-sm-12 col-lg">Business or Mayor's Permit / PEZA Certificate Attachment:</dt>
                    <dd class="col-sm-12 col-lg">
                        @{
                            var permitFileUrl = BuildAttachmentUrl(register?.Id, "bus_perm", register?.EstBisPermitFile);
                        }
                        @if (string.IsNullOrEmpty(permitFileUrl))
                        {
                            <span class="text-muted">No file uploaded</span>
                        }
                        else
                        {
                            <a href="@permitFileUrl" target="_blank" rel="noopener noreferrer">View Business or Mayor's Permit / PEZA Certificate Attachment</a>
                        }
                    </dd>
                    <dd class="col-sm-12 col-lg">
                        <input asp-for="CheckList.est_bus_perm_ck" type="checkbox" class="form-check-input remarks-check-box" onclick="return false;" tabindex="-1" />
                        <input asp-for="Remarks.est_bus_perm_input" type="text" class="form-control mb-3 input-remarks" readonly />
                    </dd>
                </div>
                <hr class="row mb-3" />
                <div class="row gap-3">
                    <dt class="col-sm-12 col-lg">Valid National ID Number:</dt>
                    <dd class="col-sm-12 col-lg">@FormatString(register?.EstOwnerValidIDNumber)</dd>
                    <dd class="col-sm-12 col-lg">
                        <input asp-for="CheckList.est_valid_number_ck" type="checkbox" class="form-check-input remarks-check-box" onclick="return false;" tabindex="-1" />
                        <input asp-for="Remarks.est_valid_number_input" type="text" class="form-control mb-3 input-remarks" readonly />
                    </dd>
                </div>
                <hr class="row mb-3" />
                <div class="row gap-3">
                    <dt class="col-sm-12 col-lg">Valid National Government ID Issued Date:</dt>
                    <dd class="col-sm-12 col-lg">@FormatDate(register?.EstOwnerValidIDDateIssued)</dd>
                    <dd class="col-sm-12 col-lg">
                        <input asp-for="CheckList.est_valid_dateiss_ck" type="checkbox" class="form-check-input remarks-check-box" onclick="return false;" tabindex="-1" />
                        <input asp-for="Remarks.est_valid_dateiss_input" type="text" class="form-control mb-3 input-remarks" readonly />
                    </dd>
                </div>
                <hr class="row mb-3" />
                <div class="row gap-3">
                    <dt class="col-sm-12 col-lg">Valid National Government ID Validity:</dt>
                    <dd class="col-sm-12 col-lg">@FormatDate(register?.EstOwnerValidIDDateExpire)</dd>
                    <dd class="col-sm-12 col-lg">
                        <input asp-for="CheckList.est_valid_validity_ck" type="checkbox" class="form-check-input remarks-check-box" onclick="return false;" tabindex="-1" />
                        <input asp-for="Remarks.est_valid_validity_input" type="text" class="form-control mb-3 input-remarks" readonly />
                    </dd>
                </div>
                <hr class="row mb-3" />
                <div class="row gap-3">
                    <dt class="col-sm-12 col-lg">Valid ID Attachment:</dt>
                    <dd class="col-sm-12 col-lg">
                        @{
                            var validIdUrl = BuildAttachmentUrl(register?.Id, "valid_id", register?.EstOwnerValidIDFile);
                        }
                        @if (string.IsNullOrEmpty(validIdUrl))
                        {
                            <span class="text-muted">No file uploaded</span>
                        }
                        else
                        {
                            <a href="@validIdUrl" target="_blank" rel="noopener noreferrer">View Valid ID</a>
                        }
                    </dd>
                    <dd class="col-sm-12 col-lg">
                        <input asp-for="CheckList.est_termrep_ck" type="checkbox" class="form-check-input remarks-check-box" onclick="return false;" tabindex="-1" />
                        <input asp-for="Remarks.est_termrep_input" type="text" class="form-control mb-3 input-remarks" readonly />
                    </dd>
                </div>
            </dl>
        </div>
    </div>
    <div class="tab-pane fade" id="approved_action" role="tabpanel"
         aria-labelledby="approved_action-ap-tab">
        <div class="row">
            <div class="p-4 bg-light">
                <div class="row gap-2 mb-4 bg-secondary bg-gradient p-3 text-white rounded">
                    <div class="row gap-2">
                        <dt class="col-sm-12 col-lg fw-light">Previous Remarks:</dt>
                        <dd class="col-sm-12 col-lg">
                            @FormatString(register?.EstEvalRemarks)
                        </dd>
                        <dt class="col-sm-12 col-lg fw-light">Remarks by PO Head, if Any:</dt>
                        <dd class="col-sm-12 col-lg">
                            @FormatString(register?.EstPoHeadRemarks)
                        </dd>
                    </div>
                </div>
                <form method="post"
                      enctype="multipart/form-data"
                      asp-area="Admin"
                      asp-controller="Evaluator"
                      asp-action="SendReapplicationEmail"
                      asp-route-id="@register?.Id">
                    @Html.AntiForgeryToken()

                    <div class="row mb-4">
                        <div class="col-lg-12 col-sm-12">
                            <label for="emailMessage">
                                Email Message: <span class="text-muted fw-lighter">(optional)</span>
                            </label>
                            <textarea id="emailMessage"
                                      name="emailMessage"
                                      class="form-control"
                                      rows="6"
                                      maxlength="255"></textarea>
                        </div>
                    </div>
                    <div class="row gap-3">
                        <div class="col-sm-12 col-lg">
                            <button type="submit" class="btn btn-primary bg-gradient btn-block">Send Email</button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
    <div class="tab-pane fade" id="branch-units">
        <div class="row">
            <div class="p-4 bg-light">
                <h4>Branch Unit</h4>
                <div class="table-responsive">
                    <table class="table table-bordered" id="datatable" width="100%" cellspacing="0">
                        <thead>
                            <tr>
                                <th width="10%">#</th>
                                <th width="30%">Rule 1020 Registration #</th>
                                <th width="30%">Branch Establishment Name</th>
                                <th width="30%">Location</th>
                            </tr>
                        </thead>
                        <tbody>

                            @if (branchUnit != null && branchUnit.Any())
                            {
                                foreach (var unit in branchUnit)
                                {
                                    <tr>
                                        <td>@branchUnitCount++</td>
                                        <td>@FormatString(unit?.Rule1020Number)</td>
                                        <td>@FormatString(unit?.BranchName)</td>
                                        <td>@FormatString(unit?.BranchAddress)</td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="4" class="text-center text-muted">No Branch Unit records found.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

    </div>
    <div id="labor-unions" class="tab-pane fade">
        <div>
            <div class="row">
                <div class="p-4 bg-light">
                    <h4>Labor Union</h4>
                    <div class="table-responsive">
                        <table class="table table-bordered" id="datatable" width="100%" cellspacing="0">
                            <thead>
                                <tr>
                                    <th width="10%">#</th>
                                    <th width="30%">Labor Union Name</th>
                                    <th width="30%">Labor Union Address</th>
                                    <th width="30%">Labor Union BLR reg. #</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (laborUnion != null && laborUnion.Any())
                                {
                                    foreach (var union in laborUnion)
                                    {
                                        <tr>
                                            <td>@laborUnionCount++</td>
                                            <td>@FormatString(union?.UnionName)</td>
                                            <td>@FormatString(union?.UnionAddress)</td>
                                            <td>@FormatString(union?.UnionBLR)</td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="4" class="text-center text-muted">No labor union records found.</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>
