@page
@model LoginModel

@{
    ViewData["Title"] = "Log in";
}
<div class="bg-primary">
    <div class="min-vh-100 d-flex flex-row align-items-center">
        <div class="container">

            <!-- Outer Row -->
            <div class="row justify-content-center">

                <div class="col-xl-4 col-lg-6 col-md-9">

                    <div class="card my-5 mx-auto">
                        <div class="card-body">
                            <div class="row d-inline-block">
                                <a asp-area="Client" asp-controller="Register" asp-action="Index" class="btn btn-outline-primary form-control btn-sm border-0 d-inline-block text-start"><i class="fas fa-arrow-left"></i><small class="d-inline-flex text-nowrap">Back to Hom</small>e</a>
                            </div>
                            <!-- Nested Row within Card Body -->
                            <div class="row">
                                @*<div class="col-lg-6 d-none d-lg-block bg-login-image"></div>*@
                                <div class="col-12 align-items-center">
                                    <div class="p-2">
                                        <div class="text-center mb-4">
                                            <img src="~/img/Client/dole-system-logo-triangle.png" height="50">
                                            <div style="line-height:100%;"><small>Republic of the Philippines<br><strong>DEPARTMENT OF LABOR AND EMPLOYMENT</strong><br>Regional Office IV-A</small></div>
                                        </div>
                                        <form class="user" id="account" method="post">
                                            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
                                            <div class="form-group form-floating mb-3">
                                                <input input asp-for="Input.Email" type="email" class="form-control form-control-user"
                                                       id="exampleInputEmail" aria-describedby="emailHelp" placeholder="Enter Email">
                                                <label asp-for="Input.Email" class="form-label">Email</label>
                                                <span asp-validation-for="Input.Email" class="text-danger"></span>
                                            </div>
                                            <div class="form-group form-floating mb-3">
                                                <input input asp-for="Input.Password" type="password" class="form-control form-control-user"
                                                       id="exampleInputPassword" placeholder="Enter Password">
                                                <label asp-for="Input.Password" class="form-label">Password</label>
                                                <span asp-validation-for="Input.Password" class="text-danger"></span>
                                            </div>
                                            <div class="form-group">
                                                <div class="custom-control custom-checkbox small">
                                                    <input asp-for="Input.RememberMe" type="checkbox" class="custom-control-input" id="customCheck">
                                                    <label class="custom-control-label" for="customCheck">
                                                        @Html.DisplayNameFor(m => m.Input.RememberMe)
                                                    </label>
                                                </div>
                                            </div>
                                            <div class="d-grid">
                                                <button id="login-submit" type="submit" class="btn btn-primary btn-user btn-block">
                                                    Login
                                                </button>
                                            </div>
                                        </form>

                                        <hr>

                                        <section>
                                            @{
                                                if ((Model.ExternalLogins?.Count ?? 0) == 0)
                                                {
                                                    <div>
                                                        <p>
                                                            There are no external authentication services configured.
                                                            See this
                                                            <a href="https://go.microsoft.com/fwlink/?LinkID=532715">
                                                                article about setting up this ASP.NET application to support logging in via external services
                                                            </a>.
                                                        </p>
                                                    </div>
                                                }
                                                else
                                                {
                                                    <form id="external-account"
                                                          asp-page="./ExternalLogin"
                                                          asp-route-returnUrl="@Model.ReturnUrl"
                                                          method="post"
                                                          class="form-horizontal">

                                                        <div>
                                                            <p>
                                                                @foreach (var provider in Model.ExternalLogins!)
                                                                {
                                                                    if (provider.DisplayName == "Facebook")
                                                                    {
                                                                        <div class="d-grid">
                                                                            <button type="submit"
                                                                                    class="btn btn-primary btn-block"
                                                                                    name="provider"
                                                                                    value="@provider.Name"
                                                                                    title="Log in with @provider.DisplayName">

                                                                                <i class="fab fa-facebook-f fa-fw"></i>
                                                                                Login with Facebook
                                                                            </button>
                                                                        </div>
                                                                    }
                                                                    else
                                                                    {
                                                                        <div class="d-grid">
                                                                            <button type="submit"
                                                                                    class="btn btn-primary"
                                                                                    name="provider"
                                                                                    value="@provider.Name"
                                                                                    title="Log in using your @provider.DisplayName account">

                                                                                Login with @provider.DisplayName
                                                                            </button>
                                                                        </div>
                                                                    }
                                                                }
                                                            </p>
                                                        </div>
                                                    </form>
                                                }
                                            }
                                        </section>
                                        <hr>
                                        <div class="text-center">
                                            <a class="small" id="forgot-password" asp-page="./ForgotPassword">Forgot Password?</a>
                                        </div>
                                        <div class="text-center">
                                            <a class="small" asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl">Register Establishment (For new Registration)</a>
                                        </div>
                                        <div class="text-center">
                                            <a class="small" id="resend-confirmation" asp-page="./ResendEmailConfirmation">Resend Confirmation Email</a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                </div>

            </div>

        </div>
    </div>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
