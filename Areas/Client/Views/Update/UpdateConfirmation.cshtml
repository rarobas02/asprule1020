@model UpdateVM
@{
    ViewData["Title"] = "Update Confirmation";

    var fullAddress = string.Join(", ", new[]
    {
        Model?.Register?.EstStreet,
        Model?.Register?.EstBrgy,
        Model?.Register?.EstCityMun,
        Model?.Register?.EstProvince,
        Model?.Register?.EstRegion
    }.Where(x => !string.IsNullOrWhiteSpace(x)));

    var email = Model?.ApplicationUser?.Email ?? Model?.Register?.Email;
}

<div class="d-flex justify-content-center align-items-center">
    <div class="card shadow text-center" style="max-width: 40rem; width: 100%;">
        <div class="card-body" style="font-size: 1.08rem;">
            <div class="mb-3">
                <img src="~/img/_Layout/undraw_profile.svg" class="rounded-circle" alt="Icon" width="80" height="80">
            </div>

            <div class="alert alert-success d-flex align-items-center" role="alert">
                <i class="me-2 bi bi-check-circle-fill"></i>
                <div>Your update request has been submitted. A confirmation email was sent.</div>
            </div>

            <h5 class="card-title mb-3 fs-4">Updated Information</h5>

            <dl class="row text-start mb-0">
                <dt class="col-sm-4">Transaction ID</dt>
                <dd class="col-sm-8">@Model?.Register?.TransId</dd>

                <dt class="col-sm-4">Establishment Name</dt>
                <dd class="col-sm-8">@Model?.Register?.EstName</dd>

                <dt class="col-sm-4">Address</dt>
                <dd class="col-sm-8">@fullAddress</dd>

                <dt class="col-sm-4">Registration Status</dt>
                <dd class="col-sm-8"></><span class="badge text-bg-primary">@Model?.Register?.EstStatus</span></dd>
            </dl>

            <div class="d-grid gap-2 mt-4">
                <a asp-area="Client"
                   asp-controller="Update"
                   asp-action="Index"
                   asp-route-registerId="@Model?.Register?.Id"
                   class="btn btn-secondary">
                    Back to Update Form
                </a>

                <form asp-area="Identity"
                      asp-page="/Account/Logout"
                      asp-route-returnUrl="@Url.Action("Index", "Register", new { area = "Client" })"
                      method="post"
                      class="d-grid">
                    <button type="submit" class="btn btn-primary">
                        Logout and Back to Home
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>